# Environment variables
GEMINI_API_KEY=

# Vercel Cron (missões): segredo enviado pela Vercel como "Authorization: Bearer <CRON_SECRET>". Use uma string aleatória com 16+ caracteres.
CRON_SECRET=

# Instagram Analytics (docs/instagram.md): token de longa duração da conta profissional (Instagram API com Instagram Login). Só servidor.
INSTAGRAM_ACCESS_TOKEN=
# Opcional: versão da Graph API (padrão v23.0)
INSTAGRAM_API_VERSION=

# Google Agenda (docs/google-agenda.md): conta de serviço (JSON ou Base64) com a agenda compartilhada, e o ID da agenda. Só servidor.
# Se omitida, usa FIREBASE_SERVICE_ACCOUNT_KEY (a agenda precisa ser compartilhada com o e-mail dessa conta).
GOOGLE_CALENDAR_SERVICE_ACCOUNT_KEY=
GOOGLE_CALENDAR_ID=

# Vercel Blob (heroidacidade-thumb)
# A conexão utiliza autenticação OIDC nativa gerenciada automaticamente pela Vercel.
# BLOB_STORE_ID e VERCEL_OIDC_TOKEN são fornecidos pelo runtime da Vercel.
BLOB_STORE_ID=

# Firebase Client Configuration (Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
