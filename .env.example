# Environment variables
GEMINI_API_KEY=

# Vercel Blob (heroidacidade-thumb)
# A conexão utiliza autenticação OIDC nativa gerenciada automaticamente pela Vercel.
# BLOB_STORE_ID e VERCEL_OIDC_TOKEN são fornecidos pelo runtime da Vercel.
BLOB_STORE_ID=

# Firebase Client Configuration (Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
