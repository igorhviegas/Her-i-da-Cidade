# Environment variables
GEMINI_API_KEY=

# Vercel Cron (missões): segredo enviado pela Vercel como "Authorization: Bearer <CRON_SECRET>". Use uma string aleatória com 16+ caracteres.
CRON_SECRET=

# Instagram Analytics (docs/instagram.md): token de longa duração da conta profissional (Instagram API com Instagram Login). Só servidor.
INSTAGRAM_ACCESS_TOKEN=
# Opcional: versão da Graph API (padrão v23.0)
INSTAGRAM_API_VERSION=

# Google Agenda (docs/google-agenda.md): conta de serviço (JSON ou Base64) com a agenda compartilhada, e o ID da agenda. Só servidor.
# Se omitida, usa FIREBASE_SERVICE_ACCOUNT_KEY (a agenda precisa ser compartilhada com o e-mail dessa conta).
GOOGLE_CALENDAR_SERVICE_ACCOUNT_KEY=
GOOGLE_CALENDAR_ID=

# Vercel Blob (heroidacidade-thumb)
# A conexão utiliza autenticação OIDC nativa gerenciada automaticamente pela Vercel.
# BLOB_STORE_ID e VERCEL_OIDC_TOKEN são fornecidos pelo runtime da Vercel.
BLOB_STORE_ID=

# Firebase Client Configuration (Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=


# Fit (docs/fit.md): segredo do Health Auto Export (string aleatória com 32+ caracteres) e UID do Firebase Auth de quem recebe os dados. Só servidor.
FIT_INGEST_TOKEN=
FIT_OWNER_UID=

# Deslocamento dos eventos (docs/deslocamento.md). Só servidor; nunca com prefixo VITE_.
# Chave do Google Cloud com Geocoding API e Routes API ativadas, restrita a essas duas APIs.
GOOGLE_MAPS_API_KEY=
# Código de acesso da ferramenta (string aleatória com 16+ caracteres); o agente digita uma vez no aparelho.
TRAVEL_ACCESS_CODE=
# Endereços padrão (rua, número, bairro, cidade). A parada e o destino são opcionais (destino vazio = mesmo da partida).
TRAVEL_START_ADDRESS=
TRAVEL_STOP_ADDRESS=
TRAVEL_END_ADDRESS=
# Rótulos exibidos nos trechos (opcional; padrão: Ponto de partida / Parada / Destino final).
TRAVEL_START_LABEL=
TRAVEL_STOP_LABEL=
TRAVEL_END_LABEL=
# WhatsApp que recebe o texto do deslocamento (DDD + número). Só sai do servidor depois de o código ser validado.
TRAVEL_WHATSAPP_NUMBER=
