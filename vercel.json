{
  "crons": [
    {
      "path": "/api/instagram-sync?job=missions",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/instagram-sync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/instagram-sync",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/video-call",
      "schedule": "0 10 * * *"
    }
  ],
  "functions": {
    "api/instagram-sync.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    },
    {
      "source": "/api/upload-kart-pdf",
      "destination": "/api/upload-thumbnail?kind=kart-pdf"
    }
  ]
}